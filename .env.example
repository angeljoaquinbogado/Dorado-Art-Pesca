# DORADO ARTÍCULOS DE PESCA — variables de entorno para Vercel
# Nunca guardes valores reales de secretos dentro del repositorio.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sitio público
PUBLIC_SITE_URL=https://dorado-art-pesca.vercel.app

# Seguridad
# Recomendado: cadena aleatoria larga e independiente.
# Si falta, el servidor deriva una clave separada desde SERVICE_ROLE sin reutilizarla directamente.
RATE_LIMIT_SECRET=

# Mercado Pago
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_REQUIRE_SIGNATURE=false

# Email automático
GMAIL_USER=doradoartpesca@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_REPLY_TO=doradoartpesca@gmail.com
