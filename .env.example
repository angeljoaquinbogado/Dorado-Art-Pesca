# Supabase (proyecto exclusivo de Dorado)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sitio
PUBLIC_SITE_URL=https://www.doradoarticulosdepesca.com.ar
RATE_LIMIT_SECRET=
GLOBAL_STOCK_APP_ORIGIN=https://globalstocks.vercel.app
GLOBAL_STOCK_ALLOWED_ORIGINS=https://globalstocks.vercel.app,https://global-stock-angel-6b19.vercel.app

# Mercado Pago — mantener false hasta tener producción confirmada
MERCADOPAGO_ENABLED=false
# Configurar true SOLO después de validar 3 cuotas de 0% interés en Checkout real.
# En modo false no se anuncian cuotas sin interés ni se aumenta el precio de productos promocionales.
MERCADOPAGO_3_CUOTAS_VERIFICADAS=false
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_REQUIRE_SIGNATURE=false

# Email comercial — Gmail con contraseña de aplicación (NO usar la contraseña normal)
GMAIL_USER=doradoartpesca@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_REPLY_TO=doradoartpesca@gmail.com


# Transferencia bancaria — datos públicos que se muestran al cliente
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_CBU=
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_TAX_ID=
BANK_TRANSFER_BANK=

# MODO — habilitar solo cuando exista integración comercial real
MODO_ENABLED=false
