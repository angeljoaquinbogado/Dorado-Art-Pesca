{
  "cSpell.enabled": false,
  "cSpell.language": "es,en",
  "cSpell.ignorePaths": [
    "node_modules/**",
    "package-lock.json",
    "docs/archive/**"
  ],
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true
  }
}
