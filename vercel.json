{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' https://sdk.mercadopago.com https://http2.mlstatic.com https://*.mercadopago.com 'sha256-z1KyOwqNsIK1tktSIYD/GBoGKV86pZ6n/40FRLILRec=' 'sha256-1VwHVpQXTpjDxmuj6QRoT2cTTh3w81QS98/aHYB5BZI='; script-src-attr 'none'; connect-src 'self' https://*.supabase.co https://api.mercadopago.com https://sdk.mercadopago.com https://*.mercadopago.com https://*.mlstatic.com; frame-src https://www.google.com https://maps.google.com https://sdk.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://www.mercadopago.com https://mercadopago.com; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/pedido.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/gracias.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/global-stock-integrations",
      "destination": "/api/products?mode=global-stock-integrations"
    },
    {
      "source": "/api/global-stock-connector",
      "destination": "/api/products?mode=global-stock-connector"
    },
    {
      "source": "/api/global-stock-authorize",
      "destination": "/api/products?mode=global-stock-authorize"
    },
    {
      "source": "/api/google-business-oauth/start",
      "destination": "/api/reviews?action=google_oauth_start"
    },
    {
      "source": "/api/google-business-oauth/callback",
      "destination": "/api/reviews?action=google_oauth_callback"
    },
    {
      "source": "/gracias.html",
      "destination": "/index.html"
    }
  ]
}
